<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/usernameBannerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="0dp" android:layout_marginTop="0dp">

        <ImageView
            android:id="@+id/usernameBannerBg"
            android:layout_width="250dp"
            android:layout_height="100dp"
            android:scaleType="fitXY"
            android:src="@drawable/username_ui"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/topUsernameText"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:gravity="center"
            android:text="Име"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/usernameBannerBg"
            app:layout_constraintStart_toStartOf="@+id/usernameBannerBg"
            app:layout_constraintTop_toTopOf="@+id/usernameBannerBg" />

        <View
            android:id="@+id/btnLogout"
            android:layout_width="31dp"
            android:layout_height="39dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/usernameBannerBg"
            app:layout_constraintEnd_toEndOf="@+id/usernameBannerBg"
            app:layout_constraintTop_toTopOf="@+id/usernameBannerBg" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="          v1.7.1-BETA [PROJECT: CONQUEST BETA]"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="16dp"
            tools:layout_editor_absoluteY="70dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/mainBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/menu_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="268dp"
        android:layout_height="58dp"
        android:layout_marginBottom="36dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnLeaderboards"
        android:layout_width="242dp"
        android:layout_height="61dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnPlay" />

    <Button
        android:id="@+id/btnQuit"
        android:layout_width="241dp"
        android:layout_height="61dp"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="28dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnPlay" />
    <ImageView
        android:id="@+id/btnHelp"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="80dp"
        android:elevation="10dp"
        android:src="@drawable/help_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/helpOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:elevation="50dp"
        android:visibility="gone"> <ImageView
        android:id="@+id/helpBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="32dp"
        android:src="@drawable/help_ui"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/helpBackground"
            app:layout_constraintEnd_toEndOf="@+id/helpBackground"
            app:layout_constraintStart_toStartOf="@+id/helpBackground"
            app:layout_constraintTop_toTopOf="@+id/helpBackground">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Добре дошли в BULGARIA TRIVIA GAME!\n\nЦЕЛ НА ИГРАТA\nПревземете цялата карта на България, като отговаряте правилно на въпроси!\n\nФАЗА 1: ПРЕВЗЕМАНЕ\nВ началото териториите са неутрални. Отборите се редуват да избират региони. Задава се въпрос с 4 отговора. Ако отговорите правилно, печелите територията!\n\nФАЗА 2: АТАКА\nКогато картата се напълни, започва истинската война! Можете да атакувате съседна вражеска територия. Атакуващият отговаря първи. Ако сгреши, атаката пропада веднага! Ако познае, защитникът също трябва да отговори. Ако и двамата познаят, битката се решава с Дуел!\n\nДУЕЛ (ТАЙБРЕЙКЪР)\nЗадава се отворен въпрос с числов отговор. Имате 30 секунди! Този, чийто отговор е най-близо до верния, печели територията. При абсолютно равенство – по-бързият печели!\n\nКРЕПОСТИ (СТОЛИЦИ)\nСофия и Бургас са столици и са по-трудни за превземане. Те имат по 2 живота! За да ги превземете, трябва да ги победите два пъти успешно.\n\nУспех и нека по-знаещият отбор победи!"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"/>
        </ScrollView>

        <View
            android:id="@+id/btnCloseHelp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintEnd_toEndOf="@+id/helpBackground"
            app:layout_constraintTop_toTopOf="@+id/helpBackground" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="10dp"
        android:src="@drawable/settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:elevation="50dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/settingsBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="32dp"
            android:src="@drawable/help_ui"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="@+id/settingsBackground"
            app:layout_constraintEnd_toEndOf="@+id/settingsBackground"
            app:layout_constraintStart_toStartOf="@+id/settingsBackground"
            app:layout_constraintTop_toTopOf="@+id/settingsBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАСТРОЙКИ"
                android:textColor="#3E2723"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="40dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAudio"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="ЗВУК: ВКЛЮЧЕН"
                android:textColor="#3E2723"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGraphics"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="ГРАФИКА: ВИСОКА"
                android:textColor="#3E2723"
                android:textSize="22sp"
                android:textStyle="bold"
                android:checked="true"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDifficulty"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="ТРУДНОСТ: ЛЕСНА"
                android:textColor="#3E2723"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <View
            android:id="@+id/btnCloseSettings"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintEnd_toEndOf="@+id/settingsBackground"
            app:layout_constraintTop_toTopOf="@+id/settingsBackground" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>