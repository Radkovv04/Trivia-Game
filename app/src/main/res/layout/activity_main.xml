                android:text="Добре дошли в BULGARIA TRIVIA GAME!\n\nЦЕЛ НА ИГРАТA\nПревземете цялата карта на България, като отговаряте правилно на въпроси!\n\nФАЗА 1: ПРЕВЗЕМАНЕ\nВ началото териториите са неутрални. Отборите се редуват да избират региони. Задава се въпрос с 4 отговора. Ако отговорите правилно, печелите територията!\n\nФАЗА 2: АТАКА\nКогато картата се напълни, започва истинската война! Можете да атакувате съседна вражеска територия. Атакуващият отговаря първи. Ако сгреши, атаката пропада веднага! Ако познае, защитникът също трябва да отговори. Ако и двамата познаят, битката се решава с Дуел!\n\nДУЕЛ (ТАЙБРЕЙКЪР)\nЗадава се отворен въпрос с числов отговор. Имате 30 секунди! Този, чийто отговор е най-близо до верния, печели територията. При абсолютно равенство – по-бързият печели!\n\nКРЕПОСТИ (СТОЛИЦИ)\nСофия и Бургас са столици и са по-трудни за превземане. Те имат по 2 живота! За да ги превземете, трябва да ги победите два пъти успешно.\n\nУспех и нека по-знаещият отбор победи!"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"/>
        </ScrollView>

        <View
            android:id="@+id/btnCloseHelp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintEnd_toEndOf="@+id/helpBackground"
            app:layout_constraintTop_toTopOf="@+id/helpBackground" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/btnSurrender"
        android:layout_width="63dp"
        android:layout_height="63dp"
        android:layout_marginEnd="124dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/surrender"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quitDialogLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:elevation="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/quitDialogImage"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/quit_midgame"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnConfirmQuit"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="30dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="@id/quitDialogImage"
            app:layout_constraintStart_toStartOf="@id/quitDialogImage" />

        <Button
            android:id="@+id/btnCancelQuit"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="30dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="@id/quitDialogImage"
            app:layout_constraintEnd_toEndOf="@id/quitDialogImage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginTop="340dp"
        android:layout_marginEnd="24dp"
        android:elevation="10dp"
        android:src="@drawable/settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:elevation="50dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/settingsBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="32dp"
            android:src="@drawable/help_ui"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="@+id/settingsBackground"
            app:layout_constraintEnd_toEndOf="@+id/settingsBackground"
            app:layout_constraintStart_toStartOf="@+id/settingsBackground"
            app:layout_constraintTop_toTopOf="@+id/settingsBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАСТРОЙКИ"
                android:textColor="#3E2723"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="40dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAudio"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="ЗВУК: ВКЛЮЧЕН"
                android:textColor="#3E2723"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchGraphics"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="ГРАФИКА: ВИСОКА"
                android:textColor="#3E2723"
                android:textSize="22sp"
                android:textStyle="bold"
                android:checked="true"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>

        <View
            android:id="@+id/btnCloseSettings"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintEnd_toEndOf="@+id/settingsBackground"
            app:layout_constraintTop_toTopOf="@+id/settingsBackground" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>