<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/questionMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qustions_background">

    <TextView
        android:id="@+id/redTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Red Team"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.098"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.65" />

    <TextView
        android:id="@+id/blueTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blue Team"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.65" />

    <TextView
        android:id="@+id/turnIndicatorTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ред на Червените"
        android:textColor="#FF0000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.072" />

    <TextView
        android:id="@+id/questionTextView"
        android:layout_width="464dp"
        android:layout_height="72dp"
        android:gravity="center"
        android:text="Коя е столицата на България?"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.31"
        app:layout_constraintWidth_percent="0.5" />
    <Button
        android:id="@+id/btnOpt1A"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:text="A:"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="start|center_vertical"
        android:paddingStart="45dp"
        app:layout_constraintHorizontal_bias="0.277"
        app:layout_constraintVertical_bias="0.440"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnOpt1"
        android:layout_width="215dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:gravity="start|center_vertical"
        android:paddingStart="10dp"
        android:stateListAnimator="@null"
        android:text="A:   Пловдив"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.325"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.440" />
    <Button
        android:id="@+id/btnOpt2B"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:text="Б:"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="start|center_vertical"
        android:paddingStart="45dp"
        app:layout_constraintHorizontal_bias="0.277"
        app:layout_constraintVertical_bias="0.557"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnOpt2"
        android:layout_width="215dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:gravity="start|center_vertical"
        android:paddingStart="10dp"
        android:text="B:   Варна"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.325"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.555" />
    <Button
        android:id="@+id/btnOpt3C"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:text="B:"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="start|center_vertical"
        android:paddingStart="45dp"
        app:layout_constraintHorizontal_bias="0.623"
        app:layout_constraintVertical_bias="0.440"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnOpt3"
        android:layout_width="215dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:gravity="start|center_vertical"
        android:paddingStart="10dp"
        app:backgroundTint="@null"
        android:text="C:   София"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.667"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.440" />
    <Button
        android:id="@+id/btnOpt4D"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:text="Г:"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="start|center_vertical"
        android:paddingStart="45dp"
        app:layout_constraintHorizontal_bias="0.623"
        app:layout_constraintVertical_bias="0.557"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnOpt4"
        android:layout_width="215dp"
        android:layout_height="38dp"
        android:background="@android:color/transparent"
        android:gravity="start|center_vertical"
        android:paddingStart="10dp"
        app:backgroundTint="@null"
        android:text="D:   Велико"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.667"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.555" />

    <Button
        android:id="@+id/submitButton"
        android:layout_width="186dp"
        android:layout_height="53dp"
        android:backgroundTint="@android:color/transparent"
        android:text=""
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.748" />

    <TextView
        android:id="@+id/timerTextView"
        android:layout_width="47dp"
        android:layout_height="51dp"
        android:background="@android:color/transparent"
        android:elevation="10dp"
        android:gravity="center"
        android:text="20"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="342dp"
        tools:layout_editor_absoluteY="52dp"
        app:layout_constraintBottom_toTopOf="@+id/questionTextView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>